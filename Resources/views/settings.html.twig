{% extends 'base.html.twig' %}
{% block page_title %}{{ 'kanka_notices.title'|trans }}{% endblock %}
{% block main %}
<div class="alert alert-warning">{{ 'kanka_notices.development'|trans }}</div>
<div class="card"><div class="card-body">
    <h2 class="card-title">{{ 'kanka_notices.profiles'|trans }}</h2>
    <p>{{ 'kanka_notices.boundaries'|trans }}</p>
    {% for profile in profiles %}
    <div class="border rounded p-3 mb-3">
        <h3>{{ profile.name }}</h3>
        <p>{{ profile.description }}</p>
        <p>{{ profile.id }} · {{ 'kanka_notices.revision'|trans }} {{ profile.revision }} · {{ (profile.active ? 'kanka_notices.active' : 'kanka_notices.inactive')|trans }}</p>
        {% for language, content in profile.translations %}
        <h4>{{ language|language_name }} ({{ language }})</h4>
        <p>{{ content.short|nl2br }}</p>
        {% for block in content.blocks %}<h5>{{ block.title }}</h5><p>{{ block.text|nl2br }}</p>{% endfor %}
        {% endfor %}
    </div>
    {% else %}<p>{{ 'kanka_notices.empty'|trans }}</p>{% endfor %}
</div></div>
<p class="mt-3">{{ 'kanka_notices.developer'|trans }} <a href="https://kanka.dev">kanka.dev</a> · <a href="https://github.com/kankadev/kimai-invoice-notices">{{ 'kanka_notices.documentation'|trans }}</a></p>
{% endblock %}
